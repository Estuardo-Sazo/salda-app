# Copiá este archivo como .env.local y completá con los datos de Supabase
# (Project Settings → API). Nunca pongas la llave service_role aquí.
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Correo que aparece en Términos y Privacidad para consultas y solicitudes de datos (opcional).
VITE_CONTACT_EMAIL=
